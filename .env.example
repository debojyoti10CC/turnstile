# Network: localnet | testnet | mainnet (mainnet only for the exact fallback)
NETWORK=localnet
ALGOD_SERVER=http://localhost
ALGOD_PORT=4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
INDEXER_SERVER=http://localhost
INDEXER_PORT=8980

# Escrow app (filled by deploy script)
ESCROW_APP_ID=
USDC_ASA_ID=

# Merchant (server) — NEVER commit real mnemonics
RECEIVER_ADDRESS=
RECEIVER_AUTHORIZER_MNEMONIC=
FEE_PAYER_MNEMONIC=
WITHDRAW_DELAY_SECONDS=900
CHANNEL_DB_PATH=./turnstile.sqlite

# Agent (client)
PAYER_MNEMONIC=
MAX_DEPOSIT_ATOMIC=5000000

# Settler (standalone service, apps/settler) — must point at the same
# CHANNEL_DB_PATH the merchant was started with; InMemoryChannelStorage
# cannot be shared across processes
RECEIVER_SENDER_ADDRESS=
RECEIVER_SENDER_PRIVATE_KEY=
POLL_INTERVAL_MS=30000
CLAIM_THRESHOLD_ATOMIC=
CLAIM_PERIODIC_MS=
SETTLE_MIN_UNSETTLED_ATOMIC=

# Exact fallback via GoPlausible
EXACT_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Demo LLM (optional; stub model used when empty)
LLM_API_KEY=
